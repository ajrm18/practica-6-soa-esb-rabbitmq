<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Productos - Frontend MVC</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main>
    <h1>Productos</h1>
    <p class="subtitulo">Datos obtenidos del servicio SOA (SOAP/WSDL)</p>

    {{#if error}}
      <p class="error" role="alert">{{error}}</p>
    {{/if}}

    <ul>
      {{#each productos}}
        <li><span>{{nombre}}</span> <strong>${{precio}}</strong></li>
      {{/each}}
    </ul>
  </main>
</body>
</html>
